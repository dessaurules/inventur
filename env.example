# --- E-Mail ---
# 1) PocketBase → Settings → Mail (SMTP/Meta: appName, appURL, Absender) — u. a. Verifikation, Reset, OTP.
# 2) Einladungen (`user_invites`): Versand per PocketBase-Hook `pocketbase-bin/pb_hooks/invites.pb.js`.
#    Der Link in der Mail muss die React-App öffnen (Vite :5173 oder gebautes Frontend), nicht PocketBase :8090 —
#    sonst erscheint nur JSON „File not found“ / 404.
#    Priorität im Hook: APP_PUBLIC_URL aus .env (wird per `npm run pb` geladen) > PocketBase Meta → Application URL.
#    Meta parallel setzen (optional): `npm run sync-pb-meta-app-url` (liest .env, Superuser PATCH).
APP_NAME=Inventur
# Open Food Facts (Barcode-Name): User-Agent mit Kontakt – laut OFF-Richtlinie, hilft gegen 429
# OPENFOODFACTS_USER_AGENT=vibe-inventur/1.0 (https://example.com/kontakt)
# Öffentliche App-URL (Einladungsmail ?invite=…) — lokal Vite; Produktion: eigene HTTPS-URL setzen.
APP_PUBLIC_URL=http://localhost:5173

# --- PocketBase (erforderlich für Login, Registrierung, Nutzerverwaltung) ---
# PocketBase separat starten (z. B. ./pocketbase serve), dann:
POCKETBASE_URL=http://127.0.0.1:8090
# Tipp: Unter :8090/ gibt es mit `pb_public/index.html` eine Kurzinfos/Weiterleitung für falsche Aufrufe (z. B. ?invite= → :5173).
# Superuser für http://127.0.0.1:8090/_/ (Collection _superusers) — nötig für npm run server: /api/users, Einladungen, …
# Nicht mit einem normalen App-Nutzer aus der Collection „users“ verwechseln.
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=dein-admin-passwort
# Optional: Name der Auth-Collection (Standard: users)
# POCKETBASE_USERS_COLLECTION=users
# Optional: Einladungen (Standard: user_invites) – muss zur Migration passen
# POCKETBASE_INVITES_COLLECTION=user_invites

# Optional Frontend (.env): andere Auth-Collection
# VITE_POCKETBASE_USERS_COLLECTION=users
# VITE_POCKETBASE_USER_INVITES_COLLECTION=user_invites

# --- Frontend: PocketBase direkt (empfohlen für `npm run dev`) ---
# Ohne diese Zeile nutzt die App http://localhost:5173/api/pb → Vite leitet an Port 3000 weiter.
# Dann MUSS parallel `npm run server` laufen (POCKETBASE_URL in .env).
# Mit direkter URL reicht PocketBase + Vite; in PB unter Settings → die Origin erlauben, z. B.:
#   http://localhost:5173
# VITE_POCKETBASE_URL=http://127.0.0.1:8090

# PocketBase Collections (Frontend; Standardnamen wie Migration pb_migrations)
# VITE_POCKETBASE_ARTICLES_COLLECTION=artikel
# VITE_POCKETBASE_ZAEHL_SESSIONS=zaehl_sessions
# VITE_POCKETBASE_ZAEHLUNG_AKTUELL=zaehlung_aktuell
# VITE_POCKETBASE_INVENTUR_ARCHIV=inventur_archiv
# VITE_POCKETBASE_STANDORTE=standorte
# VITE_POCKETBASE_LAGER=lager
# VITE_POCKETBASE_UNTERLAGER=unterlager
# VITE_POCKETBASE_USER_UNTERLAGER=user_unterlager

# Nur lokal: beim Anlegen/Aktualisieren von Artikeln in der Browser-Konsole Payload + pbBaseUrl loggen (400/debugging)
# VITE_DEBUG_PB_ARTICLE_SAVE=true

# --- Mandanten-Bootstrap (Backend / Superuser-API, kein manuelles PB-Dashboard) ---
# Bei Serverstart (npm run server): wenn 1, legt der Node-Server per Admin-API an bzw. verknüpft:
# - standorte (nur wenn noch keiner existiert), sonst ersten bestehenden nutzen (oder BOOTSTRAP_STANDORT_ID)
# - users.tenant_id für alle Nutzer ohne Mandant (abschaltbar)
# Optional: Standard-Lager/Unterlager
# TENANT_BOOTSTRAP_ON_START=1
# DEFAULT_STANDORT_NAME=Mein Unternehmen
# DEFAULT_STANDORT_ANSCHRIFT=…
# BOOTSTRAP_STANDORT_ID=   # optional feste ID, wenn schon Datensätze existieren
# BOOTSTRAP_LINK_USERS_WITHOUT_TENANT=1
# BOOTSTRAP_ENSURE_HAUPTLAGER=0
# BOOTSTRAP_LAGER_NAME=Hauptlager
# BOOTSTRAP_UNTERLAGER_NAME=Standard
# POCKETBASE_STANDORTE_COLLECTION=standorte
# POCKETBASE_LAGER_COLLECTION=lager
# POCKETBASE_UNTERLAGER_COLLECTION=unterlager
# Einmalig in der Shell: npm run bootstrap:tenant (setzt TENANT_BOOTSTRAP_ON_START implizit)
